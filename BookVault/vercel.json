{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build -- --configuration production",
  "outputDirectory": "dist/bookvault/browser",
  "rewrites": [
    {
      "source": "/api/v1/:path*",
      "destination": "https://dayana-unfended-will.ngrok-free.dev/api/v1/:path*"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
