POSTGRES_PASSWORD=1234
JWT_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Clé partagée catalog → notification (header X-BookVault-Internal-Key)
BOOKVAULT_INTERNAL_SERVICE_KEY=bookvault-internal-dev

# notification-service — SMTP (ex. Gmail : port 587)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=noreply@bukvault.com
EMAIL_ENABLED=true
EMAIL_ENABLED=true
# Liens dans les e-mails (prod Vercel ou local)
FRONTEND_URL=https://bukvault.vercel.app

# Google OAuth (console.cloud.google.com) — client ID type « Application Web »
# Origines JS autorisées : http://localhost:4200 ET https://bukvault.vercel.app
GOOGLE_CLIENT_ID=

# auth-service → notification-service (e-mails de vérification)
NOTIFICATION_SERVICE_URI=http://localhost:8088
ADMIN_PRIMARY_USER_ID=10000000-0000-4000-a000-000000000002
ADMIN_PRIMARY_EMAIL=

# community-service (API communauté + messagerie), défaut 8092 — doit correspondre à api-gateway COMMUNITY_SERVICE_URI
COMMUNITY_SERVICE_PORT=8092
COMMUNITY_SERVICE_URI=http://localhost:8092
# COMMUNITY_SEED_ENABLED=true

# URL publique HTTPS de l'api-gateway (8080) — pour webhooks G2TPay et proxy Vercel (BookVault/vercel.json)
# Ex. tunnel ngrok : https://xxxx.ngrok-free.app
GATEWAY_PUBLIC_URL=

# G2TPay — Mobile Money Cameroun (https://g2tpay.net/docs/HTTP_INTEGRATION.md)
# Clé API : tableau de bord G2TPay → Clés API → SDK (ex. /api-keys/42/sdk)
G2TPAY_ENABLED=false
G2TPAY_API_KEY=
G2TPAY_BASE_URL=https://g2tpay.net
# Callback webhook (prioritaire) — doit pointer vers order-service via gateway :
# https://VOTRE-GATEWAY-PUBLIQUE/api/v1/orders/webhook/g2tpay
# Si vide, construit à partir de GATEWAY_PUBLIC_URL
G2TPAY_WEBHOOK_URL=
G2TPAY_EUR_TO_XAF_RATE=655.957
# Valeurs operator exactes depuis SDK « Intégration HTTP » sur g2tpay.net
G2TPAY_OPERATOR_MTN=MTN_CMR
G2TPAY_OPERATOR_ORANGE=ORANGE_CMR
